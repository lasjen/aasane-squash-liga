        },
        "matches_winner_check": {
          "name": "matches_winner_check",
          "value": "\"matches\".\"winner_id\" IS NULL OR \"matches\".\"winner_id\" IN (\"matches\".\"player1_id\", \"matches\".\"player2_id\")"
        },
        "matches_winner_status_check": {
          "name": "matches_winner_status_check",
          "value": "(\"matches\".\"status\" IN ('played', 'walkover')) = (\"matches\".\"winner_id\" IS NOT NULL)"
        }
      },
