          "value": "(\"matches\".\"player1_games\" IS NULL) = (\"matches\".\"player2_games\" IS NULL)\n        AND (\"matches\".\"player1_games\" IS NULL OR (\"matches\".\"player1_games\" BETWEEN 0 AND 3\n          AND \"matches\".\"player2_games\" BETWEEN 0 AND 3 AND \"matches\".\"player1_games\" <> \"matches\".\"player2_games\"))"
